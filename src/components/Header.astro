---
import { SITE } from "../data/site";

const NAV = [
  { href: "#trabajo", label: "Trabajo" },
  { href: "#agentica", label: "Agéntica" },
  { href: "#skills", label: "Skills" },
  { href: "#contacto", label: "Contacto" },
] as const;
---

<header>
  <div class="logo">{SITE.logo}</div>
  <nav aria-label="Principal">
    <ul>
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    background: var(--bg);
    border-bottom: 2px solid var(--border);
    z-index: 10;
  }
  .logo {
    padding: 18px 40px;
    font-weight: 900;
    font-size: 18px;
    letter-spacing: -0.02em;
    background: var(--accent);
    color: var(--accent-ink);
    text-transform: uppercase;
  }
  nav { display: flex; }
  nav ul {
    display: flex;
    list-style: none;
  }
  nav li { display: flex; }
  nav a {
    display: flex;
    align-items: center;
    padding: 0 28px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-left: 2px solid var(--border);
    transition: background 0.15s, color 0.15s;
  }
  nav a:hover {
    background: var(--card);
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .logo { padding: 14px 24px; }
    nav a { padding: 14px 14px; }
  }
</style>
