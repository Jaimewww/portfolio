---
import { SITE } from "../data/site";
---

<div class="hero">
  <div class="inner">
    <div class="hero-id">
      <div class="avatar" data-impeccable-ignore="hard-offset-shadow">
        <svg viewBox="0 0 120 120" role="img" aria-label={`Retrato de ${SITE.name}`}>
          <rect width="120" height="120" fill="#262626" />
          <path d="M20 120 C20 94 38 86 60 86 C82 86 100 94 100 120 Z" fill="#c4b5fd" />
          <rect x="52" y="72" width="16" height="16" rx="7" fill="#d9a06b" />
          <ellipse cx="60" cy="52" rx="23" ry="25" fill="#e0b089" />
          <path d="M37 50 C35 27 49 20 60 20 C71 20 85 27 83 50 C83 44 77 40 60 40 C43 40 37 44 37 50 Z" fill="#111111" />
          <circle cx="50" cy="53" r="8" fill="none" stroke="#f5f5f0" stroke-width="2.5" />
          <circle cx="70" cy="53" r="8" fill="none" stroke="#f5f5f0" stroke-width="2.5" />
          <line x1="58" y1="53" x2="62" y2="53" stroke="#f5f5f0" stroke-width="2.5" />
          <line x1="42" y1="53" x2="37" y2="51" stroke="#f5f5f0" stroke-width="2.5" />
          <line x1="78" y1="53" x2="83" y2="51" stroke="#f5f5f0" stroke-width="2.5" />
          <path d="M52 66 Q60 71 68 66" fill="none" stroke="#111111" stroke-width="2.5" stroke-linecap="round" />
        </svg>
      </div>
      <p class="whoami"><span class="sigil">$</span> whoami</p>
    </div>
    <h1>{SITE.name}, <span class="hl">{SITE.role.split(" ")[0]}</span> {SITE.role.split(" ").slice(1).join(" ")}.<span class="cursor" aria-hidden="true"></span></h1>
    <p class="lede">{SITE.lede}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" data-impeccable-ignore="hard-offset-shadow" href="#trabajo">Mira mi trabajo</a>
      <a class="btn btn-ghost" href="#contacto">Escríbeme</a>
    </div>
  </div>
</div>

<style>
  .hero {
    padding: 90px 40px 70px;
    border-bottom: 2px solid var(--border);
  }
  .inner {
    max-width: 1300px;
    margin: 0 auto;
  }
  .hero-id {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
  }
  .avatar {
    width: 96px;
    height: 96px;
    border: 2px solid var(--ink);
    box-shadow: 6px 6px 0 var(--accent);
    overflow: hidden;
    background: #262626;
    flex-shrink: 0;
  }
  .avatar svg { width: 100%; height: 100%; }
  .whoami {
    font-family: var(--mono);
    font-size: 15px;
    color: var(--text-dim);
  }
  .whoami .sigil { color: var(--accent); font-weight: 700; }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    background: var(--accent);
    vertical-align: text-bottom;
    margin-left: 12px;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  h1 {
    font-size: 96px;
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    max-width: 18ch;
  }
  .hl {
    color: var(--accent-ink);
    background: var(--accent);
    padding: 0 12px;
    display: inline-block;
  }
  .lede {
    margin-top: 28px;
    max-width: 66ch;
    font-size: 18px;
    color: var(--text-dim);
  }
  .hero-actions {
    margin-top: 44px;
    display: flex;
    gap: 16px;
  }
  @media (max-width: 900px) {
    .hero { padding: 56px 24px 48px; }
    .inner { padding: 0; }
    .hero-id { flex-wrap: wrap; }
    .avatar { width: 72px; height: 72px; }
    h1 { font-size: 52px; }
  }
</style>
