---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import Projects from "../components/Projects.astro";
import Agentica from "../components/Agentica.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";

const title = "Jaime Landázuri — Desarrollador Full-Stack";
const description =
  "Desarrollador full-stack desde Loja, Ecuador: APIs sólidas, interfaces rápidas y código legible, con dos años entregando software en producción y disponible para freelance y equipos remotos.";
---

<Base title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Marquee />
    <Projects />
    <Agentica />
    <Skills />
    <Contact />
  </main>
  <Footer />
</Base>
