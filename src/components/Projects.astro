---
import { PROJECTS } from "../data/projects";
---

<section id="trabajo" class="work" aria-labelledby="trabajo-titulo">
  <div class="inner">
    <h2 id="trabajo-titulo">Proyectos</h2>
    <div class="grid">
      {
        PROJECTS.map((project) => (
          <a class="card" href={project.href} rel="noopener">
            <span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <span class="foot">
                <span class="stack">{project.stack}</span>
                <span class="cta">Ver caso →</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work {
    padding: 80px 40px;
  }
  .inner {
    max-width: 1300px;
    margin: 0 auto;
  }
  h2 {
    font-size: 48px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 40px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: var(--border);
    border: 2px solid var(--border);
  }
  .card {
    background: var(--card);
    padding: 40px;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    transition: background 0.15s;
  }
  .card:hover { background: #242424; }
  .card h3 {
    font-size: 32px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .card p {
    margin-top: 12px;
    color: var(--text-dim);
    font-size: 15px;
    max-width: 44ch;
  }
  .foot {
    margin-top: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .stack {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-dim);
  }
  .cta {
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .work { padding: 56px 24px; }
    .inner { padding: 0; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
